#!/bin/sh
set -eu
# zephrctl — command a running Zephr over its Unix socket (docs/DESIGN.md §4.8).
#
# Usage:
#   zephrctl focus left|down|up|right      zephrctl move left|down|up|right
#   zephrctl workspace N                   zephrctl send-to-workspace N
#   zephrctl toggle-float | monocle | balance | rescue | close
#   zephrctl pause | resume                zephrctl focus-window <id>
#   zephrctl list-windows | list-workspaces | subscribe
#
# Install: cp tools/zephrctl /usr/local/bin/ && chmod +x /usr/local/bin/zephrctl

SOCK="$HOME/Library/Application Support/Zephr/zephr.sock"

if [ "${1:-}" = "--help" ] || [ -z "${1:-}" ]; then
    sed -n '3,11p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi

if [ ! -S "$SOCK" ]; then
    echo "zephr is not running (no socket at $SOCK)" >&2
    exit 1
fi

# Transport: perl, not nc. macOS `nc` quits the moment stdin hits EOF, so it
# loses a race against any reply the server defers — `doctor` scans off the
# main actor and answers ~40 ms later, and nc would exit 0 having printed
# nothing, which looks exactly like a command that worked. perl ships with
# macOS and `IO::Socket::UNIX` is core.
#
# The client deliberately does NOT shut down its write side: the server reads
# that as EOF and drops the connection, taking any pending async reply with
# it. It just writes the request and reads until the server half-closes,
# which is also what lets `subscribe` stream indefinitely.
if ! command -v perl >/dev/null 2>&1; then
    echo "zephrctl: needs perl to talk to $SOCK" >&2
    exit 1
fi

# Exit status follows the reply: an error reply must fail the command, or
# `zephrctl … && next-thing` runs the next thing anyway and `set -e` never
# trips. The reply is echoed either way.
reply=$(printf '%s\n' "$*" | perl -MIO::Socket::UNIX -e '
    my $path = shift;
    my $sock = IO::Socket::UNIX->new(Peer => $path, Type => SOCK_STREAM())
        or die "zephrctl: cannot connect to $path: $!\n";
    my $request = do { local $/; <STDIN> };
    print {$sock} $request;
    $| = 1;                 # stream `subscribe` line by line
    print while <$sock>;
' "$SOCK")
status=$?
[ -n "$reply" ] && printf '%s\n' "$reply"
[ "$status" -ne 0 ] && exit "$status"
case "$reply" in
    *'"ok":false'*) exit 1 ;;
esac
exit 0
